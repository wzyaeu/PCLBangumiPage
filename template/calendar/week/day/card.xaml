<local:MyCard Margin="5"
              Width="131.2"
            Height="177">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <local:MyImage
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Source="{{pic}}"
                FallbackSource="https://bangumi.p.kaphia.top/resources/image_placeholder_3_4.png"/>
        </StackPanel>
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Height="23"
                Margin="3"
                Background="#00b0ff"
                CornerRadius="7">
            <StackPanel HorizontalAlignment="Stretch"
                        Margin="3"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <TextBlock FontSize="9"
                           Margin="2,0,0,0"
                           Foreground="#ffffff"
                           VerticalAlignment="Bottom"
                           Text="Rank排名"/>
                <TextBlock FontSize="15"
                           Margin="3,0,0,0"
                           Foreground="#ffffff"
                           Text="{{rank}}"/>
            </StackPanel>
        </Border>
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Height="19"
                Margin="3,28,3,3"
                Background="#ffb53d"
                CornerRadius="7">
            <StackPanel Margin="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Bottom"
                           FontSize="11"
                           Foreground="#ffffff"
                           Text="评分 {{score}}"
                           ToolTip="{{score-all}} 人评分&#xa;&#xa;详细评级&#xa;10: {{score-10}}&#xa;9: {{score-9}}&#xa;8: {{score-8}}&#xa;7: {{score-7}}&#xa;6: {{score-6}}&#xa;5: {{score-5}}&#xa;4: {{score-4}}&#xa;3: {{score-3}}&#xa;2: {{score-2}}&#xa;1: {{score-1}}"/>
            </StackPanel>
        </Border>
        <Border VerticalAlignment="Bottom"
                Height="50"
                Background="Black"
                Opacity="0.4"/>
        <StackPanel VerticalAlignment="Bottom"
                    Height="50">
            <TextBlock Margin="4"
                       FontWeight="Bold"
                       FontSize="15"
                       Height="17"
                       Foreground="#ffffff"
                       Text="{{name-cn}}"
                       ToolTip="{{name-cn}} / {{name}}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            Margin="3,0">
                    <local:MyButton HorizontalAlignment="Right"
                                    Margin="1,0,1,0"
                                    Height="21"
                                    Width="50"
                                    Text="复制"
                                    ToolTip="复制名称，不复制译名"
                                    EventType="复制文本"
                                    EventData="{{name}}"/>
                    <local:MyButton HorizontalAlignment="Right"
                                    Margin="1,0,1,0"
                                    Height="21"
                                    Width="50"
                                    Text="查看"
                                    EventType="打开网页"
                                    EventData="{{link}}"/>
                </StackPanel>
        </StackPanel>
    </Grid>
</local:MyCard>